<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security Headers
  <IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
  </IfModule>

  # Dynamic Sitemap: Tự động đồng bộ URL mới từ database thời gian thực
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]

  # SPA Routing: Route non-existing files/directories to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteRule ^ index.html [L]
</IfModule>

# Chặn truy cập trực tiếp vào các file cấu hình và dữ liệu nhạy cảm
<FilesMatch "(\.env|\.sql|\.jsonl|config\.php)$">
  Order allow,deny
  Deny from all
</FilesMatch>
